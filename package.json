{
  "name": "dragonsheets-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DragonSheets Chrome extension - Amazon Seller Central + Ads data in Google Sheets.",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "npm run icons && vite build",
    "icons": "node scripts/generate-icons.mjs",
    "typecheck": "tsc --noEmit",
    "test:analytics": "node scripts/run-analytics-harness.mjs",
    "zip": "node scripts/zip-extension.mjs",
    "test:browser": "node test/browser/smoke.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.25.12",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
